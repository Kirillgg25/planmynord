PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-secret
APP_BASE_URL=http://localhost:3000

# Optional PostGIS geo cache.
# Start locally with: docker compose up -d postgis
POSTGIS_DATABASE_URL=postgres://tripplanner:tripplanner_dev_password@localhost:5432/tripplanner_geo
POSTGIS_CACHE_TTL_HOURS=168
POSTGIS_POOL_SIZE=4
# Set to true only when your hosted provider requires SSL.
POSTGIS_SSL=false

# Admin accounts, comma-separated.
ADMIN_EMAILS=admin@example.com

# Google OAuth.
# In Google Cloud Console add this redirect URI:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OpenID Connect provider for Commonplace Finance.
# Store the private JWKS and client secret only in the server's local secret store.
OIDC_ISSUER=https://planmynord.com/oidc
OIDC_JWKS=
OIDC_STORAGE_DIR=
COMMONPLACE_OIDC_CLIENT_ID=commonplace-finance
COMMONPLACE_OIDC_CLIENT_SECRET=
COMMONPLACE_OIDC_REDIRECT_URI=http://127.0.0.1:3100/api/auth/oidc/callback
COMMONPLACE_DESKTOP_CLIENT_ID=commonplace-desktop
COMMONPLACE_DESKTOP_REDIRECT_URI=com.commonplace.finance://oauth2redirect

# Optional AI support. Without a key, local support answers still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional support payment amount.
SUPPORT_PLAN_NAME=TripPlanner Support
SUPPORT_PRICE_NOK=99

# PlanMyNord VPN product. Profile delivery requires a reviewed VPN server API.
VPN_PLAN_NAME=PlanMyNord VPN
VPN_PRICE_NOK=99
VPN_DURATION_DAYS=30
VPN_DEVICE_LIMIT=3

# Email verification SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM="TripPlanner <your@email.com>"

# Private Cloudflare R2 backups for data/app.db.
R2_BACKUP_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=planmynord-backups
R2_BACKUP_PREFIX=sqlite
R2_BACKUP_HOUR_UTC=2
